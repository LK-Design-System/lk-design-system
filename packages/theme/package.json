{
  "name": "@lk-robotics/lds-theme",
  "version": "0.1.0-rc.1",
  "description": "LK brand, color, typography, and theme layer.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "styles.css",
    "tokens",
    "assets"
  ],
  "sideEffects": [
    "*.css",
    "tokens/*.css"
  ],
  "dependencies": {
    "@lk-robotics/lds-core": "0.1.0-rc.1"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./styles.css": "./styles.css",
    "./tokens/*": "./tokens/*",
    "./assets/*": "./assets/*"
  }
}
