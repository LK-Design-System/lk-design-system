{
  "name": "@lk-robotics/lds-theme",
  "version": "0.1.0",
  "description": "LK brand, color, typography, and theme layer.",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "styles.css",
    "tokens",
    "assets"
  ],
  "sideEffects": [
    "*.css",
    "tokens/*.css"
  ],
  "dependencies": {
    "@lk-robotics/lds-core": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./styles.css": "./styles.css",
    "./tokens/*": "./tokens/*",
    "./assets/*": "./assets/*"
  }
}
