{
  "name": "@lk-design-system/lds-core",
  "version": "0.2.0",
  "description": "Generic foundation and DOM UI for the LK ROBOTICS design system.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "docs",
    "dist",
    "styles.css",
    "tokens",
    "assets",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "*.css",
    "tokens/*.css"
  ],
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./brand-authoring": {
      "types": "./dist/brand-authoring.d.ts",
      "import": "./dist/brand-authoring.js"
    },
    "./component-authoring": {
      "types": "./dist/component-authoring.d.ts",
      "import": "./dist/component-authoring.js"
    },
    "./density": {
      "types": "./dist/density.d.ts",
      "import": "./dist/density.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js"
    },
    "./platform": {
      "types": "./dist/platform.d.ts",
      "import": "./dist/platform.js"
    },
    "./components/internal/*": null,
    "./components/private/*": null,
    "./components/brand/lk-logo-paths": null,
    "./components/forms/field-shared": null,
    "./components/overlay/anchored-overlay": null,
    "./components/overlay/overlay-platform": null,
    "./components/overlay/anchored-panel-style": null,
    "./components/overlay/dialog-focus": null,
    "./components/selection/pill-chip-style": null,
    "./components/status/status-presentation": null,
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./styles.css": "./styles.css",
    "./tokens/*": "./tokens/*",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json",
    "./design-system.json": "./docs/manifest.json",
    "./llms.txt": "./docs/llms.txt",
    "./adoption-checklist.json": "./docs/adoption-checklist.json",
    "./docs/*": "./docs/*"
  },
  "lds": {
    "schemaVersion": 1,
    "layer": "core",
    "manifest": "./docs/manifest.json",
    "llms": "./docs/llms.txt",
    "adoptionChecklist": "./docs/adoption-checklist.json",
    "adoptionReportSchema": "./docs/adoption-report.schema.json",
    "semanticContract": "./tokens/semantic-contract.json",
    "requiresSemanticContractVersion": "1",
    "storybook": "https://lk-design-system.github.io/lk-design-system/?path=/docs/lds-core-foundation-design-token--docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LK-Design-System/lk-design-system.git",
    "directory": "packages/core"
  },
  "homepage": "https://lk-design-system.github.io/lk-design-system/?path=/docs/lds-core-foundation-design-token--docs",
  "bugs": {
    "url": "https://github.com/LK-Design-System/lk-design-system/issues"
  }
}
