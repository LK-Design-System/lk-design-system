    ]
  },
  {
    "name": "duplicate-style-import",
    "expectedCodes": ["STYLE_IMPORT_ORDER"],
    "mutations": [
      { "file": ".storybook/preview.jsx", "append": "import '@lk-robotics/lds-core/styles.css';\n" }
    ]
  },
  {
    "name": "reordered-style-import",
    "expectedCodes": ["STYLE_IMPORT_ORDER"],
    "mutations": [
      {
