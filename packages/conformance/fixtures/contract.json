{
  "$schema": "./CROSS_REPOSITORY_STYLE_CONTRACT.schema.json",
  "schemaVersion": 1,
  "kind": "lds-cross-repository-style-contract",
  "lds": {
    "repository": "LK-ROBOTICS/lk-design-system",
    "tokenSources": ["tokens"],
    "storybookMastheadCopy": "storybook-masthead-copy.json",
    "ownedTokenPrefixes": ["--color-", "--space-", "--radius-", "--font-"],
    "packages": [
      { "name": "@lk-robotics/lds-core", "version": "0.1.0-rc.1", "workspace": "packages/core" },
      { "name": "@lk-robotics/lds-theme", "version": "0.1.0-rc.1", "workspace": "packages/theme" },
      { "name": "@lk-robotics/lds-product", "version": "0.1.0-rc.1", "workspace": "packages/product" }
    ]
  },
  "profiles": {
    "robotics-ui": {
      "repository": "LK-Design-System/lk-design-system-robotics",
      "package": { "name": "@lk-robotics/lds-robotics-ui", "version": "0.1.0-rc.3" },
      "externalSurface": "external-surface.json",
      "configFile": ".lds-conformance.json",
      "policyContracts": ["robotics-policy.json"],
      "packageDependencies": [
        { "name": "@lk-robotics/lds-core", "section": "dependencies", "version": "0.1.0-rc.1" },
        { "name": "@lk-robotics/lds-product", "section": "dependencies", "version": "0.1.0-rc.1" },
        { "name": "@lk-robotics/lds-theme", "section": "devDependencies", "version": "0.1.0-rc.1" }
      ],
      "scanRoots": ["src", "stories", "tokens", ".storybook", "styles.css"],
      "requiredStyleImports": [
        "@lk-robotics/lds-core/styles.css",
        "@lk-robotics/lds-theme/styles.css",
        "@lk-robotics/lds-product/styles.css",
        "../styles.css"
      ],
      "storybookPreview": ".storybook/preview.jsx",
      "localTokenDefinitions": {
        "file": "tokens/components.css",
        "compatibilityMirror": "tokens/components.css",
        "allowedReferencePrefixes": ["--color-semantic-"],
        "names": ["--component-viewer-surface"]
      },
      "runtimeCustomProperties": [
        { "name": "--viewer-surface", "definitionFile": "src/components/ViewerFrame.jsx" },
        { "name": "--map-grid-line", "definitionFile": "src/components/Map2DCanvas.jsx" }
      ],
      "inheritedRuntimeCustomProperties": [
        { "name": "--product-viewer-surface", "package": "@lk-robotics/lds-product", "definitionFile": "packages/product/src/components/ViewerFrame.jsx" }
      ],
      "rawColorPolicy": {
        "forbiddenFormats": ["hex", "rgb", "hsl", "named-white-black"],
        "allowedZones": [
          {
            "file": "src/components/Widget.jsx",
            "signature": "color-mix(in srgb, var(--color-semantic-primary-normal), white 10%)",
            "expectedOccurrences": 1,
            "owner": "Fixture owner",
            "reason": "Proves that a raw-color allowance is bound to one exact expression.",
            "reviewDate": "2027-01-31"
          }
        ]
      },
      "focusOverride": {
        "file": "tokens/focus.css",
        "declaration": "outline: none !important",
        "provingStoryId": "fixture-widget--overview",
        "evidenceSelector": "[data-map-shape]"
      },
      "representativeStories": [
        { "source": "stories/Widget.stories.jsx", "export": "Overview", "id": "fixture-widget--overview", "viewport": "320x568" }
      ]
    },
    "lds3d-ui": {
      "repository": "LK-Design-System/lk-design-system-3d",
      "workspacePackage": { "manifest": "package.json", "name": "@lk-robotics/lds-3d", "version": "0.1.0-alpha.1" },
      "compositionManifest": "apps/docs/package.json",
      "lockfile": "pnpm-lock.yaml",
      "externalSurface": "lds3d-external-surface.json",
      "configFile": ".lds-conformance.json",
      "policyContracts": [],
      "packageDependencies": [
        { "manifest": "apps/docs/package.json", "name": "@lk-robotics/lds-core", "section": "dependencies", "version": "0.1.0-rc.1" },
        { "manifest": "apps/docs/package.json", "name": "@lk-robotics/lds-theme", "section": "dependencies", "version": "0.1.0-rc.1" },
        { "manifest": "apps/docs/package.json", "name": "@lk-robotics/lds-product", "section": "dependencies", "version": "0.1.0-rc.1" },
        { "manifest": "apps/docs/package.json", "name": "@lk-robotics/lds-robotics-ui", "section": "dependencies", "version": "0.1.0-rc.3" }
      ],
      "scanRoots": ["apps/docs/.storybook", "apps/docs/src", "packages"],
      "rawColorScanRoots": ["apps/docs/.storybook/preview.ts", "apps/docs/src/styles.css", "apps/docs/src/visual-alpha-ui.tsx"],
      "requiredStyleImports": ["@lk-robotics/lds-core/styles.css", "@lk-robotics/lds-theme/styles.css", "@lk-robotics/lds-product/styles.css", "@lk-robotics/lds-robotics-ui/styles.css", "../src/styles.css"],
      "storybookPreview": "apps/docs/.storybook/preview.ts",
      "localTokenDefinitions": { "file": null, "compatibilityMirror": null, "allowedReferencePrefixes": [], "names": [] },
      "runtimeCustomProperties": [{ "name": "--lds3d-inspector-width", "definitionFile": "apps/docs/src/visual-alpha-ui.tsx" }],
      "inheritedRuntimeCustomProperties": [],
      "rawColorPolicy": {
        "forbiddenFormats": ["hex", "rgb", "hsl", "named-white-black"],
        "allowedZones": [{ "file": "apps/docs/.storybook/preview.ts", "signature": "#101828", "expectedOccurrences": 1, "owner": "Fixture owner", "reason": "Proves an exact Storybook-background allowance without allowing renderer colors into the DOM scan.", "reviewDate": "2027-01-31" }]
      },
      "headlessPackages": [{ "manifest": "packages/core/package.json", "sourceRoots": ["packages/core/src"] }, { "manifest": "packages/three/package.json", "sourceRoots": ["packages/three/src"] }],
      "representativeStories": [{ "source": "apps/docs/src/visual-alpha.stories.tsx", "export": "OperationalNeutral", "id": "visual-alpha--operational-neutral", "viewport": "1440x900" }]
    }
  }
}
