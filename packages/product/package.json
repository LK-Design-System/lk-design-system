{
  "name": "@lk-robotics/lds-product",
  "version": "0.1.0-rc.1",
  "description": "Reusable LK product patterns built on LDS Core.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "storybook",
    "styles.css",
    "tokens",
    "assets",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "*.css",
    "tokens/*.css"
  ],
  "dependencies": {
    "@lk-robotics/lds-core": "0.1.0-rc.1"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./storybook": {
      "types": "./storybook/index.d.ts",
      "import": "./storybook/index.js"
    },
    "./styles.css": "./styles.css",
    "./tokens/*": "./tokens/*",
    "./assets/*": "./assets/*"
  }
}
