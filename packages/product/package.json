{
  "name": "@lk-design-system/lds-product",
  "version": "0.1.0-rc.10",
  "description": "Reusable LK product patterns built on LDS Core.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "storybook",
    "styles.css",
    "tokens",
    "assets",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "*.css",
    "tokens/*.css"
  ],
  "dependencies": {
    "@lk-design-system/lds-core": "0.1.0-rc.10"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./storybook": {
      "types": "./storybook/index.d.ts",
      "import": "./storybook/index.js"
    },
    "./styles.css": "./styles.css",
    "./tokens/*": "./tokens/*",
    "./assets/*": "./assets/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LK-Design-System/lk-design-system.git",
    "directory": "packages/product"
  },
  "homepage": "https://github.com/LK-Design-System/lk-design-system#readme",
  "bugs": {
    "url": "https://github.com/LK-Design-System/lk-design-system/issues"
  }
}
