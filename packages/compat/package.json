{
  "name": "@lk-design-system/design-system-core",
  "version": "0.1.0-rc.8",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css",
    "tokens/*.css"
  ],
  "files": [
    "dist",
    "styles.css",
    "tokens",
    "assets",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dependencies": {
    "@lk-design-system/lds-core": "0.1.0-rc.8",
    "@lk-design-system/lds-theme": "0.1.0-rc.8",
    "@lk-design-system/lds-product": "0.1.0-rc.8",
    "@lk-design-system/lds-robotics-ui": "0.1.0-rc.4"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "require": "./dist/theme.cjs"
    },
    "./product": {
      "types": "./dist/product.d.ts",
      "import": "./dist/product.js",
      "require": "./dist/product.cjs"
    },
    "./robotics": {
      "types": "./dist/robotics.d.ts",
      "import": "./dist/robotics.js",
      "require": "./dist/robotics.cjs"
    },
    "./styles.css": "./styles.css",
    "./tokens/*": "./tokens/*",
    "./assets/*": "./assets/*",
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "require": "./dist/components/*.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LK-Design-System/lk-design-system.git",
    "directory": "packages/compat"
  },
  "homepage": "https://github.com/LK-Design-System/lk-design-system#readme",
  "bugs": {
    "url": "https://github.com/LK-Design-System/lk-design-system/issues"
  }
}
