{
  "name": "@lk-design-system/design-system-core",
  "version": "0.1.0-rc.69.5",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css",
    "tokens/*.css"
  ],
  "files": [
    "README.md",
    "docs",
    "dist",
    "styles.css",
    "tokens",
    "assets",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dependencies": {
    "@lk-design-system/lds-core": "0.1.0-rc.69.5",
    "@lk-design-system/lds-theme": "0.1.0-rc.69.5",
    "@lk-design-system/lds-product": "0.1.0-rc.69.5",
    "@lk-design-system/lds-robotics-ui": "0.1.0-rc.5"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "require": "./dist/theme.cjs"
    },
    "./product": {
      "types": "./dist/product.d.ts",
      "import": "./dist/product.js",
      "require": "./dist/product.cjs"
    },
    "./robotics": {
      "types": "./dist/robotics.d.ts",
      "import": "./dist/robotics.js",
      "require": "./dist/robotics.cjs"
    },
    "./styles.css": "./styles.css",
    "./tokens/*": "./tokens/*",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json",
    "./design-system.json": "./docs/manifest.json",
    "./llms.txt": "./docs/llms.txt",
    "./adoption-checklist.json": "./docs/adoption-checklist.json",
    "./docs/*": "./docs/*",
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "require": "./dist/components/*.cjs"
    }
  },
  "lds": {
    "schemaVersion": 1,
    "layer": "compatibility",
    "manifest": "./docs/manifest.json",
    "llms": "./docs/llms.txt",
    "adoptionChecklist": "./docs/adoption-checklist.json",
    "adoptionReportSchema": "./docs/adoption-report.schema.json",
    "storybook": "https://lk-design-system.github.io/lk-design-system/?path=/docs/lds-core-foundation-design-token--docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LK-Design-System/lk-design-system.git",
    "directory": "packages/compat"
  },
  "homepage": "https://lk-design-system.github.io/lk-design-system/?path=/docs/lds-core-foundation-design-token--docs",
  "bugs": {
    "url": "https://github.com/LK-Design-System/lk-design-system/issues"
  }
}
