        "source": "Frame/Radius Large"
      },
      "frameXl": {
        "$type": "dimension",
        "$value": "20px",
        "css": "--radius-frame-xl",
        "source": "Frame/Radius Xlarge"
      },
      "pill": {
        "$type": "dimension",
        "$value": "999px",
        "css": "--radius-pill"
      }
    },
    "typography": {
      "fontSans": {
        "$type": "fontFamily",
        "$value": "Pretendard JP, Pretendard, system-ui, sans-serif",
        "css": "--font-sans"
      },
      "fontMono": {
        "$type": "fontFamily",
        "$value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
        "css": "--font-mono"
      },
      "body1": {
        "$type": "typography",
        "$value": {
          "fontSize": "16px",
          "lineHeight": "24px",
          "letterSpacing": "0.0057em"
        },
        "css": ["--body1-size", "--body1-line", "--body1-spacing"]
      },
      "label1": {
        "$type": "typography",
        "$value": {
          "fontSize": "14px",
          "lineHeight": "20px",
          "letterSpacing": "0.0145em"
        },
        "css": ["--label1-size", "--label1-line", "--label1-spacing"]
      },
      "headline2": {
        "$type": "typography",
        "$value": {
          "fontSize": "17px",
          "lineHeight": "24px",
          "letterSpacing": "0em"
        },
        "css": ["--headline2-size", "--headline2-line", "--headline2-spacing"]
      }
    },
    "grid": {
      "breakpointSm": {
        "$type": "dimension",
        "$value": "768px",
        "css": "--bp-sm",
        "source": "Grid/Breakpoint sm"
      },
      "breakpointMd": {
        "$type": "dimension",
        "$value": "992px",
        "css": "--bp-md",
        "source": "Grid/Breakpoint md"
      },
      "breakpointLg": {
        "$type": "dimension",
        "$value": "1200px",
        "css": "--bp-lg",
        "source": "Grid/Breakpoint lg"
      },
      "breakpointXl": {
        "$type": "dimension",
        "$value": "1600px",
        "css": "--bp-xl",
        "source": "Grid/Breakpoint xl"
      },
      "columnsMobile": {
        "$type": "number",
        "$value": 2,
        "css": "--grid-columns-mobile",
        "source": "Grid/Column mobile"
      },
      "columnsTablet": {
        "$type": "number",
        "$value": 3,
        "css": "--grid-columns-tablet",
        "source": "Grid/Column tablet"
      },
      "columnsDesktop": {
        "$type": "number",
        "$value": 12,
        "css": "--grid-columns-desktop",
        "source": "Grid/Column desktop"
      },
      "gutter": {
        "$type": "dimension",
        "$value": "20px",
        "css": "--grid-gutter",
        "source": "Grid/Gutter"
      },
      "margin": {
        "$type": "dimension",
        "$value": "20px",
        "css": "--grid-margin",
        "source": "Grid/Margin"
      },
      "containerLg": {
        "$type": "dimension",
        "$value": "1100px",
        "css": "--container-lg",
        "source": "Grid/Max width"
      },
      "containerXl": {
        "$type": "dimension",
        "$value": "1440px",
        "css": "--container-xl",
        "source": "Grid/Max width xl"
      }
    },
    "effect": {
      "shadowXs": {
        "$type": "shadow",
        "$value": "0 2px 4px rgba(14, 19, 41, 0.06)",
        "css": "--shadow-xs"
      },
      "shadowSm": {
        "$type": "shadow",
        "$value": "0 4px 12px rgba(8, 14, 33, 0.06)",
        "css": "--shadow-sm"
      },
      "shadowMd": {
        "$type": "shadow",
        "$value": "0 16px 40px rgba(14, 19, 41, 0.10)",
        "css": "--shadow-md"
      },
      "shadowLg": {
        "$type": "shadow",
        "$value": "0 24px 64px rgba(14, 19, 41, 0.13)",
        "css": "--shadow-lg"
      },
      "durationFast": {
        "$type": "duration",
        "$value": "120ms",
        "css": "--dur-fast"
      },
      "durationBase": {
        "$type": "duration",
        "$value": "200ms",
        "css": "--dur-base"
      },
      "easeOut": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.4, 0, 0.2, 1)",
        "css": "--ease-out"
      },
      "decorateGradientSolidTop": {
        "$type": "gradient",
        "$value": "linear-gradient(180deg, var(--surface-raised) 0%, transparent 100%)",
        "css": "--decorate-gradient-solid-top",
        "source": "Decorate/Gradient/Solid"
      },
      "decorateGradientSolidRight": {
        "$type": "gradient",
        "$value": "linear-gradient(270deg, var(--surface-raised) 0%, transparent 100%)",
        "css": "--decorate-gradient-solid-right",
        "source": "Decorate/Gradient/Solid"
      },
      "decorateGradientSolidBottom": {
        "$type": "gradient",
        "$value": "linear-gradient(0deg, var(--surface-raised) 0%, transparent 100%)",
        "css": "--decorate-gradient-solid-bottom",
        "source": "Decorate/Gradient/Solid"
      },
      "decorateGradientSolidLeft": {
        "$type": "gradient",
        "$value": "linear-gradient(90deg, var(--surface-raised) 0%, transparent 100%)",
        "css": "--decorate-gradient-solid-left",
        "source": "Decorate/Gradient/Solid"
      },
      "decorateGradientMultipleTop": {
        "$type": "gradient",
        "$value": "linear-gradient(180deg, var(--surface-raised) 0%, var(--fill-strong) 48%, transparent 100%)",
        "css": "--decorate-gradient-multiple-top",
        "source": "Decorate/Gradient/Multiple"
      },
      "decorateGradientMultipleRight": {
        "$type": "gradient",
        "$value": "linear-gradient(270deg, var(--surface-raised) 0%, var(--fill-strong) 48%, transparent 100%)",
        "css": "--decorate-gradient-multiple-right",
        "source": "Decorate/Gradient/Multiple"
      },
      "decorateGradientMultipleBottom": {
        "$type": "gradient",
        "$value": "linear-gradient(0deg, var(--surface-raised) 0%, var(--fill-strong) 48%, transparent 100%)",
        "css": "--decorate-gradient-multiple-bottom",
        "source": "Decorate/Gradient/Multiple"
      },
      "decorateGradientMultipleLeft": {
        "$type": "gradient",
        "$value": "linear-gradient(90deg, var(--surface-raised) 0%, var(--fill-strong) 48%, transparent 100%)",
        "css": "--decorate-gradient-multiple-left",
        "source": "Decorate/Gradient/Multiple"
      },
      "decorateMaskFadeTop": {
        "$type": "gradient",
        "$value": "linear-gradient(180deg, #000 0%, transparent 100%)",
        "css": "--decorate-mask-fade-top",
        "source": "Decorate/Gradient/Mask"
      },
      "decorateMaskFadeRight": {
        "$type": "gradient",
        "$value": "linear-gradient(270deg, #000 0%, transparent 100%)",
        "css": "--decorate-mask-fade-right",
        "source": "Decorate/Gradient/Mask"
      },
      "decorateMaskFadeBottom": {
        "$type": "gradient",
        "$value": "linear-gradient(0deg, #000 0%, transparent 100%)",
        "css": "--decorate-mask-fade-bottom",
        "source": "Decorate/Gradient/Mask"
      },
      "decorateMaskFadeLeft": {
        "$type": "gradient",
        "$value": "linear-gradient(90deg, #000 0%, transparent 100%)",
        "css": "--decorate-mask-fade-left",
        "source": "Decorate/Gradient/Mask"
      },
      "interactionLayerNormal": {
        "$type": "color",
        "$value": "transparent",
        "css": "--interaction-layer-normal",
        "source": "Decorate/Interaction"
      },
      "interactionLayerDefault": {
        "$type": "color",
        "$value": "rgba(112, 115, 124, 0.08)",
        "css": "--interaction-layer-default",
        "source": "Decorate/Interaction"
      },
      "interactionLayerLight": {
        "$type": "color",
        "$value": "rgba(112, 115, 124, 0.05)",
        "css": "--interaction-layer-light",
        "source": "Decorate/Interaction"
      },
      "interactionLayerStrong": {
        "$type": "color",
        "$value": "rgba(112, 115, 124, 0.14)",
        "css": "--interaction-layer-strong",
        "source": "Decorate/Interaction"
      },
      "interactionOpacityNormal": {
        "$type": "number",
        "$value": 1,
        "css": "--interaction-opacity-normal",
        "source": "Decorate/Interaction"
      },
      "interactionOpacityHovered": {
        "$type": "number",
        "$value": 0.92,
        "css": "--interaction-opacity-hovered",
        "source": "Decorate/Interaction"
      },
      "interactionOpacityFocused": {
        "$type": "number",
        "$value": 0.84,
        "css": "--interaction-opacity-focused",
        "source": "Decorate/Interaction"
      },
      "interactionOpacityPressed": {
        "$type": "number",
        "$value": 0.76,
        "css": "--interaction-opacity-pressed",
        "source": "Decorate/Interaction"
      }
    }
  },
  "semantic": {
    "description": "제품 UI에서 쓰는 의미 기반 토큰입니다. 제품 화면에서는 primitive보다 semantic 토큰을 우선 사용합니다.",
    "surface": {
      "page": {
        "$type": "color",
        "$value": "var(--surface-page)",
        "css": "--surface-page",
        "ref": "primitive.color.paper"
      },
      "raised": {
        "$type": "color",
        "$value": "var(--surface-raised)",
        "css": "--surface-raised",
        "ref": "primitive.color.paper"
      },
      "card": {
        "$type": "color",
        "$value": "var(--surface-card)",
        "css": "--surface-card"
      },
      "inverse": {
        "$type": "color",
        "$value": "var(--surface-inverse)",
        "css": "--surface-inverse",
        "ref": "primitive.color.brandNavy"
      }
    },
    "text": {
      "strong": {
        "$type": "color",
        "$value": "var(--text-strong)",
        "css": "--text-strong"
      },
      "body": {
        "$type": "color",
        "$value": "var(--text-body)",
        "css": "--text-body"
      },
      "muted": {
        "$type": "color",
        "$value": "var(--text-muted)",
        "css": "--text-muted"
      },
      "onInverse": {
        "$type": "color",
        "$value": "var(--text-on-inverse)",
        "css": "--text-on-inverse"
      },
      "onSignal": {
        "$type": "color",
        "$value": "var(--text-on-signal)",
        "css": "--text-on-signal"
      }
    },
    "action": {
      "primary": {
        "$type": "color",
        "$value": "var(--color-primary)",
        "css": "--color-primary",
        "ref": "primitive.color.brandAzure"
      },
      "primaryHover": {
        "$type": "color",
        "$value": "var(--color-primary-hover)",
        "css": "--color-primary-hover",
        "ref": "primitive.color.brandAzureStrong"
      },
      "secondary": {
        "$type": "color",
        "$value": "var(--color-secondary)",
        "css": "--color-secondary",
        "ref": "primitive.color.graphite"
      },
      "secondaryHover": {
        "$type": "color",
        "$value": "var(--color-secondary-hover)",
        "css": "--color-secondary-hover",
        "ref": "primitive.color.graphiteStrong"
      },
      "accent": {
        "$type": "color",
        "$value": "var(--color-accent)",
        "css": "--color-accent",
        "ref": "primitive.color.signalSteelAzure"
      }
    },
    "status": {
      "positive": {
        "$type": "color",
        "$value": "var(--color-positive)",
        "css": "--color-positive"
      },
      "cautionary": {
        "$type": "color",
        "$value": "var(--color-cautionary)",
        "css": "--color-cautionary"
      },
      "danger": {
        "$type": "color",
        "$value": "var(--color-danger)",
        "css": "--color-danger"
      }
    },
    "control": {
      "heightSm": {
        "$type": "dimension",
        "$value": "var(--control-h-sm)",
        "css": "--control-h-sm"
      },
      "heightMd": {
        "$type": "dimension",
        "$value": "var(--control-h-md)",
        "css": "--control-h-md"
      },
      "heightLg": {
        "$type": "dimension",
        "$value": "var(--control-h-lg)",
        "css": "--control-h-lg"
      },
      "focusRing": {
        "$type": "shadow",
        "$value": "0 0 0 4px var(--focus-ring)",
        "css": "--focus-ring"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "var(--border-subtle)",
        "css": "--border-subtle"
      },
      "strong": {
        "$type": "color",
        "$value": "var(--border-strong)",
        "css": "--border-strong"
      },
      "hairline": {
        "$type": "border",
        "$value": "var(--border-hairline)",
        "css": "--border-hairline"
      }
    },
    "layout": {
      "mobile": {
        "safeAreaTop": {
          "$type": "dimension",
          "$value": "env(safe-area-inset-top, 0px)",
          "css": "--mobile-safe-area-top",
          "source": "Spacing/Status"
        },
        "safeAreaBottom": {
          "$type": "dimension",
          "$value": "env(safe-area-inset-bottom, 0px)",
          "css": "--mobile-safe-area-bottom",
          "source": "Spacing/Bottom"
        },
        "statusBarMinHeight": {
          "$type": "dimension",
          "$value": "44px",
          "css": "--mobile-status-bar-min-height",
          "source": "Spacing/Status"
        },
        "homeIndicatorHeight": {
          "$type": "dimension",
          "$value": "34px",
          "css": "--mobile-home-indicator-height",
          "source": "Spacing/Bottom"
        },
        "bottomBarMinHeight": {
          "$type": "dimension",
          "$value": "64px",
          "css": "--mobile-bottom-bar-min-height",
          "source": "Spacing/Bottom"
        },
        "bottomActionPaddingBottom": {
          "$type": "dimension",
          "$value": "calc(var(--space-4) + var(--mobile-safe-area-bottom))",
          "css": "--mobile-bottom-action-padding-bottom",
          "source": "Spacing/Bottom"
        }
      }
    },
    "motion": {
