      },
      "input": {
        "$type": "dimension",
        "$value": "12px",
        "css": "--radius-input"
      },
      "xl": {
        "$type": "dimension",
        "$value": "16px",
        "css": "--radius-xl"
      },
      "frameSm": {
        "$type": "dimension",
        "$value": "12px",
        "css": "--radius-frame-sm",
