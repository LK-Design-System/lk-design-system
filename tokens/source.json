      "brandNavy": {
        "$type": "color",
        "$value": "#0E1329",
        "css": "--bw-ink",
        "$description": "LK ROBOTICS navy ink 원값입니다."
      },
      "brandNavyDeep": {
        "$type": "color",
        "$value": "#080B1C",
