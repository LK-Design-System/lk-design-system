      },
      "4-5": {
        "$type": "ratio",
        "$value": "4 / 5",
        "css": "--ratio-4-5",
        "source": "Basic/Ratio"
      },
      "3-4": {
        "$type": "ratio",
        "$value": "3 / 4",
        "css": "--ratio-3-4",
