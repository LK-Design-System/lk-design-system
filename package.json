{
  "name": "@lk-robotics/design-system-core",
  "version": "0.1.0",
  "private": true,
  "description": "LK ROBOTICS core design system: tokens, components, assets, templates, and static previews.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./styles.css",
    "./tokens/*": "./tokens/*",
    "./assets/*": "./assets/*",
    "./components/*": "./components/*"
  },
  "files": [
    "dist",
    "components",
    "tokens",
    "assets",
    "styles.css",
    "guidelines",
    "templates",
    "templates-cards",
    "_ds_bundle.js",
    "readme.md"
  ],
  "sideEffects": [
    "*.css",
    "styles.css",
    "tokens/*.css"
  ],
  "scripts": {
    "generate:entry": "node scripts/generate-entry.mjs",
    "build": "npm run generate:entry && tsup && node scripts/copy-types.mjs",
    "check:entry": "npm run generate:entry && git diff --exit-code -- src/index.js src/index.d.ts",
    "check:generated": "git diff --exit-code -- src dist",
    "check:tokens": "node scripts/check-token-source.mjs",
    "check:parity": "node scripts/check-visual-parity.mjs",
    "check:coverage": "node scripts/check-audit-coverage.mjs",
    "check:map": "node scripts/check-component-card-map.mjs",
    "check:visual": "npm run build:storybook && node scripts/capture-visual-smoke.mjs",
    "check:legacy-render": "npm run build:storybook && node scripts/check-legacy-preview-render.mjs",
    "check:audit": "npm audit --omit=dev",
    "check": "npm run build && npm run check:tokens && npm run check:type-surface && npm run check:parity && npm run check:coverage && npm run check:map && npm run check:contracts && npm run check:wds-alignment && npm run check:wds-local-fig && npm run check:avatar-duplicates && npm run check:visual-token-drift && npm run check:publish-policy && tsc --noEmit && npm run check:entry && npm run check:generated && npm run check:consumer && npm run build:storybook && npm run check:tooltip-alignment && npm run check:storybook-public && npm run check:a11y && npm pack --dry-run --ignore-scripts",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build:storybook": "storybook build",
    "prepack": "npm run build",
    "check:visual-inventory": "npm run build:storybook && node scripts/capture-visual-inventory.mjs",
    "check:visual-review": "npm run check:visual-inventory && node scripts/generate-visual-review-report.mjs",
    "check:visual-diff": "npm run check:visual-review && node scripts/generate-visual-diff-report.mjs",
    "extract:wds-fig-content": "node scripts/extract-wds-fig-content.mjs",
    "check:wds-local-fig": "node scripts/check-wds-local-fig-content.mjs",
    "check:type-surface": "node scripts/check-type-surface.mjs",
    "check:contracts": "node scripts/check-design-system-contracts.mjs",
    "check:wds-alignment": "node scripts/check-wds-alignment.mjs",
    "check:avatar-duplicates": "node scripts/check-avatar-duplicates.mjs",
    "check:visual-token-drift": "node scripts/check-visual-token-drift.mjs",
    "check:publish-policy": "node scripts/check-publish-policy.mjs",
    "check:consumer": "node scripts/check-consumer-smoke.mjs",
    "check:a11y": "node scripts/check-storybook-accessibility.mjs",
    "check:ops-release": "npm run check && npm run check:audit && npm run check:legacy-render && npm run check:visual-diff",
    "check:storybook-public": "node scripts/check-storybook-public-surface.mjs",
    "check:tooltip-alignment": "node scripts/check-tooltip-alignment.mjs"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
