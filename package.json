{
  "name": "@lk-design-system/lds-workspace",
  "version": "0.1.0-rc.69.6",
  "packageManager": "npm@10.9.2",
  "private": true,
  "description": "Private workspace orchestrator for the layered LK ROBOTICS design system.",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "generate:brand": "node scripts/generate-brand-assets.mjs && node scripts/generate-product-lockups.mjs && node scripts/generate-brand-platform-assets.mjs",
    "generate:product-lockups": "node scripts/generate-product-lockups.mjs",
    "generate:brand-platforms": "node scripts/generate-brand-platform-assets.mjs",
    "generate:colors": "node scripts/generate-lk-color-system.mjs",
    "generate:foundations": "node scripts/generate-foundation-docs.mjs",
    "generate:adoption": "node scripts/generate-lds-adoption-docs.mjs && node scripts/project-package-docs.mjs",
    "generate:components": "node scripts/generate-component-docs.mjs",
    "generate:token-coverage": "node scripts/check-token-source-coverage.mjs --update",
    "generate:entry": "node scripts/generate-entry.mjs",
    "generate:workspace-sources": "node scripts/generate-workspace-sources.mjs && node scripts/generate-compat-facade.mjs && node scripts/project-workspace-styles-and-assets.mjs && node scripts/project-package-docs.mjs",
    "generate:sources": "node scripts/generate-lk-color-system.mjs && node scripts/generate-entry.mjs",
    "build:legacy": "npm run generate:sources && tsup && node scripts/copy-types.mjs && node scripts/normalize-sourcemaps.mjs",
    "build:workspaces": "npm run generate:workspace-sources && node scripts/build-workspace-packages.mjs && node scripts/copy-workspace-types.mjs",
    "build": "node scripts/normalize-source-line-endings.mjs && npm run generate:sources && npm run build:workspaces && npm run build:legacy",
    "check:entry": "node scripts/generate-entry.mjs && git diff --exit-code -- src",
    "check:generated": "git diff --exit-code -- src dist packages",
    "check:brand": "node scripts/generate-brand-assets.mjs --check && node scripts/generate-product-lockups.mjs --check && node scripts/generate-brand-platform-assets.mjs --check",
    "check:product-lockups": "node scripts/generate-product-lockups.mjs --check",
    "check:brand-platforms": "node scripts/generate-brand-platform-assets.mjs --check",
    "check:brand-products": "node scripts/check-brand-product-coverage.mjs",
    "check:tokens": "node scripts/check-token-source.mjs && node scripts/check-token-source-coverage.mjs",
    "check:colors": "node scripts/generate-lk-color-system.mjs --check && node scripts/check-color-layering.mjs && node scripts/check-color-contrast.mjs",
    "check:parity": "node scripts/check-visual-parity.mjs",
    "check:visual": "node scripts/run-package-scripts.mjs build:storybook && node scripts/capture-visual-smoke.mjs",
    "check:visual-regression": "node scripts/capture-visual-smoke.mjs --check",
    "update:visual-baseline": "node scripts/run-package-scripts.mjs build:storybook && node scripts/capture-visual-smoke.mjs --update-baseline",
    "check:audit": "node scripts/run-package-command.mjs audit-runtime",
    "check:types": "tsc --noEmit",
    "check:type-consumer": "tsc -p tsconfig.consumer-react19.json && tsc -p tsconfig.consumer-react18.json",
    "check:layers": "node scripts/check-layer-boundaries.mjs",
    "check:workspace-packages": "node scripts/check-workspace-packages.mjs",
    "check:package-migration": "node scripts/run-package-scripts.mjs check:package-migration:wave0 check:package-migration:current-ci check:workspace-packages",
    "check:package-migration:wave0": "node scripts/check-package-migration.mjs --require-wave=0",
    "check:package-migration:current-ci": "node scripts/check-package-migration.mjs --require-current-ci",
    "capture:wave0:full-check": "npm ci && node scripts/capture-wave0-full-check.mjs",
    "check:consumer:matrix": "node scripts/check-wave0-consumer-matrix.mjs",
    "capture:consumer:matrix": "node scripts/check-wave0-consumer-matrix.mjs --capture",
    "assemble:consumer:matrix": "node scripts/assemble-wave0-consumer-matrix.mjs",
    "check:fast": "node scripts/run-package-scripts.mjs build check:packed-select check:table-scroll-gutter check:tokens check:spacing-scale check:story-tokens check:guide-surfaces check:storybook-copy check:korean-ui-copy check:foundations check:adoption check:patterns check:components check:conformance check:token-hygiene check:scroll-surfaces check:surface-ownership check:colors check:type-surface check:type-consumer check:layers check:package-migration check:api-drift check:api-grammar check:dimension-literals check:motion-hygiene check:prompt-contracts check:story-coverage check:engine-reuse check:engine-contracts check:parity check:foundation-parity check:component-styles check:contracts check:docs check:product-frontends check:icon-drawing-style check:wds-alignment check:wds-local-fig check:avatar-duplicates check:story-subjects check:visual-token-drift check:release-immutability check:publish-policy check:deprecations check:types check:entry check:brand check:brand-products check:generated check:consumer",
    "check:inventory": "node scripts/report-inventory.mjs --check-docs",
    "check:storybook": "node scripts/run-package-scripts.mjs build:storybook check:storybook-adoption check:component-styles-rendered check:nested-styles check:inventory check:storybook-ia check:tooltip-alignment check:storybook-public check:a11y check:visual-regression",
    "check:pack": "node scripts/check-workspace-artifacts.mjs",
    "check:packed-select": "node scripts/check-workspace-artifacts.mjs --select-only",
    "check:table-scroll-gutter": "node scripts/check-table-scroll-gutter.mjs",
    "check:pack:ci": "node scripts/check-workspace-artifacts.mjs --output-dir=visual-artifacts/workspace-package-set",
    "check:workspace-consumer:matrix": "node scripts/check-workspace-consumer-matrix.mjs",
    "check:workspace-consumer:windows": "node scripts/check-workspace-consumer-matrix.mjs --platform=windows --package-set=visual-artifacts/workspace-package-set --require-browser",
    "check:workspace-consumer:linux": "node scripts/check-workspace-consumer-matrix.mjs --platform=linux --package-set=visual-artifacts/workspace-package-set",
    "capture:pack:baseline": "npm ci && node scripts/run-package-scripts.mjs build check:generated && node scripts/check-package-artifact.mjs --capture-baseline",
    "check:pack:baseline": "npm ci && node scripts/run-package-scripts.mjs build check:generated && node scripts/check-package-artifact.mjs --verify-baseline",
    "check:pack:baseline-if-present": "node scripts/run-package-scripts.mjs build check:generated && node scripts/check-package-artifact.mjs --verify-baseline-if-present",
    "check": "node scripts/run-package-scripts.mjs check:fast check:storybook check:pack",
    "check:storybook-ci": "node scripts/run-package-scripts.mjs build:storybook check:storybook-adoption check:component-styles-rendered check:nested-styles check:inventory check:tooltip-alignment check:storybook-public check:a11y check:visual-regression",
    "check:ci": "node scripts/run-package-scripts.mjs check:fast check:storybook-ci",
    "report:inventory": "node scripts/report-inventory.mjs",
    "report:storybook-ia": "node scripts/report-storybook-information-architecture.mjs --update",
    "check:storybook-ia": "node scripts/report-storybook-information-architecture.mjs --check && node scripts/check-pattern-guides.mjs && node scripts/check-storybook-primary-description-review.mjs",
    "check:patterns": "node scripts/check-pattern-guides.mjs",
    "check:storybook-adoption": "node scripts/check-storybook-adoption-files.mjs",
    "check:adoption": "node scripts/generate-lds-adoption-docs.mjs --check && node scripts/check-package-docs.mjs",
    "check:adoption-fixtures": "node packages/conformance/src/cli.mjs verify-adoption-contract && node packages/conformance/src/cli.mjs verify-adoption-fixtures",
    "storybook:dev": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "storybook": "node scripts/generate-lk-color-system.mjs && storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build:storybook": "node scripts/generate-lk-color-system.mjs && storybook build",
    "prepack": "node scripts/run-package-scripts.mjs build",
    "extract:wds-fig-content": "node scripts/extract-wds-fig-content.mjs",
    "check:wds-local-fig": "node scripts/check-wds-local-fig-content.mjs",
    "report:foundation-parity": "node scripts/report-wds-foundation-parity.mjs",
    "check:foundation-parity": "node scripts/report-wds-foundation-parity.mjs --check",
    "check:story-tokens": "node scripts/check-story-token-references.mjs",
    "check:spacing-scale": "node scripts/check-spacing-scale.mjs",
    "check:guide-surfaces": "node scripts/check-guide-surface-dogfooding.mjs",
    "check:storybook-copy": "node scripts/check-storybook-masthead-copy.mjs",
    "check:korean-ui-copy": "node scripts/check-korean-ui-copy.mjs",
    "update:korean-ui-copy-baseline": "node scripts/check-korean-ui-copy.mjs --update-baseline",
    "check:foundations": "node scripts/generate-foundation-docs.mjs --check && node scripts/check-foundation-coverage.mjs",
    "check:components": "node scripts/generate-component-docs.mjs --check && node scripts/check-component-coverage.mjs",
    "report:component-styles": "node scripts/check-wds-component-styles.mjs",
    "check:component-styles": "node scripts/check-wds-component-styles.mjs --check",
    "report:component-styles-rendered": "node scripts/check-wds-component-styles-rendered.mjs",
    "check:component-styles-rendered": "node scripts/check-wds-component-styles-rendered.mjs --check",
    "build:wds-deep-styles": "node scripts/build-wds-deep-styles.mjs",
    "report:nested-styles": "node scripts/check-wds-nested-styles.mjs",
    "check:nested-styles": "node scripts/check-wds-nested-styles.mjs --check",
    "report:census": "node scripts/census-wds-components.mjs",
    "check:type-surface": "node scripts/check-workspace-packages.mjs",
    "check:api-drift": "node scripts/check-api-drift.mjs",
    "update:api-drift-baseline": "node scripts/check-api-drift.mjs --update-baseline",
    "check:api-grammar": "node scripts/check-api-grammar.mjs",
    "update:api-grammar-baseline": "node scripts/check-api-grammar.mjs --update-baseline",
    "check:dimension-literals": "node scripts/check-dimension-literals.mjs",
    "update:dimension-literal-baseline": "node scripts/check-dimension-literals.mjs --update-baseline",
    "check:token-hygiene": "node scripts/check-token-hygiene.mjs",
    "check:scroll-surfaces": "node scripts/check-scroll-surface-contracts.mjs",
    "check:conformance": "node scripts/check-cross-repository-style-contract.mjs && node --test packages/conformance/src/storybook-masthead-copy.test.mjs && node packages/conformance/src/cli.mjs verify-fixtures && node packages/conformance/src/cli.mjs verify-adoption-contract && node packages/conformance/src/cli.mjs verify-adoption-fixtures",
    "check:robotics-storybook-browser": "node scripts/check-robotics-storybook-browser.mjs --root \"../lk-design-system-robotics\"",
    "check:lds3d-storybook-browser": "node scripts/check-lds3d-storybook-browser.mjs --root \"../lk-design-system-3d\"",
    "update:token-hygiene-baseline": "node scripts/check-token-hygiene.mjs --update-baseline",
    "check:motion-hygiene": "node scripts/check-motion-hygiene.mjs",
    "update:motion-hygiene-baseline": "node scripts/check-motion-hygiene.mjs --update-baseline",
    "check:prompt-contracts": "node scripts/check-prompt-contracts.mjs",
    "update:prompt-contract-baseline": "node scripts/check-prompt-contracts.mjs --update-baseline",
    "check:story-coverage": "node scripts/check-story-coverage.mjs",
    "update:story-coverage-baseline": "node scripts/check-story-coverage.mjs --update-baseline",
    "check:engine-reuse": "node scripts/check-engine-reuse.mjs",
    "update:engine-reuse-baseline": "node scripts/check-engine-reuse.mjs --update-baseline",
    "check:engine-contracts": "node scripts/check-engine-contracts.mjs",
    "check:contracts": "node scripts/check-design-system-contracts.mjs",
    "check:robotics-semantics": "node scripts/check-robotics-semantic-contracts.mjs",
    "check:robotics-contract-drift": "node scripts/check-robotics-contract-drift.mjs",
    "update:robotics-contract-drift-baseline": "node scripts/check-robotics-contract-drift.mjs --update-baseline",
    "check:docs": "node scripts/check-documentation-system.mjs",
    "check:product-frontends": "node scripts/check-product-frontend-coverage.mjs",
    "check:wds-alignment": "node --test scripts/storybook-order.test.mjs && node scripts/check-wds-alignment.mjs",
    "check:avatar-duplicates": "node scripts/check-avatar-duplicates.mjs",
    "check:story-subjects": "node scripts/check-story-subject-duplicates.mjs",
    "check:visual-token-drift": "node scripts/check-visual-token-drift.mjs",
    "check:publish-policy": "node scripts/check-publish-policy.mjs",
    "check:release-immutability": "node scripts/check-release-immutability.mjs",
    "report:deprecations": "node scripts/report-deprecations.mjs",
    "check:deprecations": "node scripts/report-deprecations.mjs --check",
    "check:consumer": "node scripts/check-consumer-smoke.mjs",
    "check:a11y": "node scripts/check-storybook-accessibility.mjs",
    "check:docs-surface": "node scripts/audit-docs-surface-system.mjs --manager --dedup-contract",
    "update:target-size-baseline": "node scripts/check-storybook-accessibility.mjs --update-target-baseline",
    "check:ops-release": "node scripts/run-package-scripts.mjs check check:audit",
    "check:storybook-public": "node scripts/check-storybook-public-surface.mjs && node scripts/check-storybook-public-copy.mjs",
    "check:tooltip-alignment": "node scripts/check-tooltip-alignment.mjs",
    "check:surface-ownership": "node scripts/check-surface-ownership.mjs",
    "check:icon-drawing-style": "node scripts/check-icon-drawing-style.mjs"
  },
  "peerDependencies": {
