    "@storybook/addon-a11y": "10.4.6",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/react-vite": "10.4.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react18": "npm:@types/react@^18.3.27",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axe-core": "^4.12.1",
    "esbuild": "^0.28.1",
    "fontkit": "2.0.4",
    "kiwi-schema": "^0.5.0",
    "opentype.js": "1.3.4",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "storybook": "10.4.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "8.1.3"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
