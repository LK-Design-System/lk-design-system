{
  "schemaVersion": 1,
  "recordType": "lk-logo-governance",
  "standard": {
    "id": "lk-robotics-logo",
    "version": "1.0.0",
    "status": "current-repository-standard",
    "effectiveDate": "2026-08-10",
    "scope": "repository brand assets, LK Design System runtime, and documented distribution workflow",
    "doesNotAssert": [
      "trademark-registration-status",
      "territorial-trademark-rights",
      "external-use-permission",
      "named-person-approval"
    ]
  },
  "authority": {
    "precedence": [
      "scripts/brand/lk-logo-source.mjs",
      "assets/brand/lk-logo-construction.json",
      "scripts/generate-brand-assets.mjs",
      "assets/brand/lk-logo-master.svg",
      "assets/brand/lk-*.svg",
      "components/brand/Lockup.jsx"
    ],
    "visualReference": "assets/brand/lk-logo-master.svg",
    "placementAssetRoot": "assets/brand",
    "policy": "docs/brand/LK_LOGO_STANDARD.md",
    "platformAssetContract": "assets/brand/platforms/manifest.json",
    "productAdoptionAudit": "docs/references/brand/PRODUCT_BRAND_ASSET_AUDIT.json",
    "verificationCommands": [
      "npm run check:brand",
      "npm run check:docs",
      "npm run check:brand-products"
    ]
  },
  "approvalRoles": {
    "brandOwner": {
      "requiredFor": [
        "visible geometry or proportion changes",
        "wordmark or corporate-name changes",
        "brand color changes",
        "new variants",
        "external distribution",
        "co-branding",
        "monochrome exceptions",
        "motion, 3D, signage, apparel, engraving, or embroidery"
      ]
    },
    "designSystemOwner": {
      "requiredFor": [
        "generator or manifest changes",
        "runtime Lockup changes",
        "asset generation and checksum verification",
        "small-use and visual-regression evidence",
        "package and documentation release"
      ]
    },
    "legalOrTrademarkReviewer": {
      "requiredWhenApplicableFor": [
        "registration claims or legal marks",
        "territorial rights questions",
        "partner or sponsorship implications",
        "license or third-party mark questions"
      ]
    },
    "printProofApprover": {
      "requiredFor": [
        "official CMYK values",
        "official Pantone values",
        "substrate-specific or process-specific color standards"
      ]
    }
  },
  "minimumSizeStatus": {
    "status": "repository-policy-pending-human-optical-approval",
    "policySource": "assets/brand/lk-logo-construction.json",
    "evidenceRequired": [
      "16-20-24-28-32-48-64-css-pixel-captures",
      "1x-and-2x-rasterization",
      "positive-and-reverse-backgrounds",
      "browser-favicon-at-16px",
      "named-human-optical-verdict"
    ],
    "approvalRecord": null
  },
  "constructionContract": {
