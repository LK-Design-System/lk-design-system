      "label": "기본 조합",
      "code": "<ContentEditor\n  titleValue={title}\n  onTitleChange={setTitle}\n  value={body}\n  onValueChange={setBody}\n  toolbarItems={[{ value: 'bold', label: '굵게', icon: 'bold', toggle: true }]}\n  activeToolbarItems={['bold']}\n  onToolbarAction={applyFormat}\n  status=\"임시 저장됨\"\n  meta=\"최종 수정 10:42\"\n  actions={<Button size=\"sm\">게시</Button>}\n/>"
