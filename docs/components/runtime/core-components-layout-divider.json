  "supportingComponents": [],
  "purpose": "같은 표면에서 의미가 다른 섹션이나 인라인 그룹을 보조할 때 사용합니다. 주제가 바뀌면 separator를, 이미 구조가 잡힌 곳의 리듬에는 decorative를 사용합니다. 여백으로 충분하면 선을 사용하지 말고, 독립 표면이 필요하면 Card나 Section을 사용하세요.",
  "useWhen": [
    "Use variant=\"normal\" for hairline separation and variant=\"thick\" for stronger section breaks."
  ],
  "avoidWhen": [],
  "anatomy": [
    {
      "part": "label",
      "rule": "Optional centered label for an \"or\" style divider."
    }
  ],
  "properties": [
    {
      "name": "vertical",
      "type": "boolean",
      "required": false,
      "description": "Render as a vertical separator. @default false",
      "owner": "DividerProps"
    },
    {
      "name": "label",
      "type": "React.ReactNode",
      "required": false,
      "description": "Optional centered label for an \"or\" style divider.",
      "owner": "DividerProps"
    },
    {
      "name": "inset",
      "type": "number",
      "required": false,
      "description": "Horizontal inset in pixels. @default 0",
      "owner": "DividerProps"
    },
    {
      "name": "variant",
      "type": "\"normal\" | \"thick\"",
      "required": false,
      "description": "divider visual weight. @default \"normal\"",
      "owner": "DividerProps"
    },
    {
      "name": "decorative",
      "type": "boolean",
      "required": false,
      "description": "순전히 시각적인 선일 때 true. role=\"none\" + aria-hidden 이 붙어 접근성 트리에서 빠집니다. 기본값 false 는 의미 있는 구분선으로 role=\"separator\"(가로형은 네이티브 )로 노출됩니다.",
      "owner": "DividerProps"
    }
  ],
  "states": [
    {
      "state": "variant",
      "rule": "divider visual weight. @default \"normal\""
    }
  ],
