  ],
  "purpose": "제품 화면의 breadcrumb, 제목, 설명, 상태, 메타데이터, 주요 액션을 일관된 상단 영역으로 묶을 때 적합합니다. 카드나 작은 섹션 제목에는 PageHeader 대신 해당 영역의 heading과 필요한 액션만 사용하세요.",
  "useWhen": [
    "제목은 사용자가 수행하는 업무 또는 화면을 가리킵니다(예: “사용자 관리”). 사람·로봇·주문처럼 대상 자체를 식별하는 visual·이름·인증 배지·스탯·대상 액션 묶음은 RecordHeader를 사용합니다."
  ],
  "avoidWhen": [
    "WAI Landmarks Pattern의 고수준 구조 원칙에 따라 PageHeader는 main 안의 로컬 이며, TopBar의 전역 banner나 Storybook 설명 chrome을 대체하지 않습니다."
  ],
  "anatomy": [
    {
      "part": "description",
      "rule": "제목 아래 설명."
    },
    {
      "part": "actions",
      "rule": "오른쪽 액션 영역."
    },
    {
      "part": "align",
      "rule": "액션 영역과 본문 수직 정렬. @default \"start\""
    }
  ],
