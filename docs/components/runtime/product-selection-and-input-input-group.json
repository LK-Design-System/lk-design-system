  "quantitativeRules": [
    {
      "subject": "명시 규칙 1",
      "rule": "Prefix and suffix are fixed context, not part of the editable value. The whole group shares one label, border, focus ring, helper/error relationship, and 32px/48px field scale."
    },
    {
