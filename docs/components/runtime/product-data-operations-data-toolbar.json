      "type": "React.ReactNode",
      "required": false,
      "description": "테이블/그리드 제목.",
      "owner": "DataToolbarProps"
    },
    {
      "name": "description",
      "type": "React.ReactNode",
      "required": false,
      "description": "제목 아래 설명.",
      "owner": "DataToolbarProps"
    },
    {
      "name": "count",
      "type": "number",
      "required": false,
      "description": "전체 결과 수.",
      "owner": "DataToolbarProps"
    },
    {
      "name": "searchValue",
      "type": "string",
      "required": false,
      "description": "제어 검색어.",
      "owner": "DataToolbarProps"
    },
    {
      "name": "defaultSearchValue",
      "type": "string",
      "required": false,
      "description": "비제어 검색어 초기값. @default \"\"",
      "owner": "DataToolbarProps"
    },
    {
      "name": "onSearchChange",
      "type": "(value: string) = void",
      "required": false,
      "description": "검색어 변경 콜백.",
      "owner": "DataToolbarProps"
    },
    {
      "name": "searchPlaceholder",
      "type": "string",
      "required": false,
      "description": "검색 input placeholder와 accessible name. @default \"검색\"",
      "owner": "DataToolbarProps"
    },
    {
      "name": "filters",
      "type": "React.ReactNode",
      "required": false,
      "description": "필터 chip/menu 슬롯.",
      "owner": "DataToolbarProps"
    },
    {
      "name": "actions",
      "type": "React.ReactNode",
      "required": false,
      "description": "우측 일반 액션 슬롯.",
      "owner": "DataToolbarProps"
    },
    {
      "name": "size",
      "type": "'sm' | 'md'",
      "required": false,
      "description": "밀도. @default \"md\"",
      "owner": "DataToolbarProps"
    },
    {
      "name": "variant",
      "type": "'standalone' | 'embedded'",
      "required": false,
      "description": "외곽선 소유. \"embedded\"는 툴바 자체 테두리·radius를 제거하고 하단 divider만 남겨, 부모 표면(section·Card) 안에서 헤더로 결합합니다. @default \"standalone\"",
      "owner": "DataToolbarProps"
    }
  ],
  "states": [
    {
      "state": "variant",
      "rule": "외곽선 소유. \"embedded\"는 툴바 자체 테두리·radius를 제거하고 하단 divider만 남겨, 부모 표면(section·Card) 안에서 헤더로 결합합니다. @default \"standalone\""
    }
  ],
  "behavior": [
    "검색은 제어/비제어 모두 가능합니다. searchValue와 onSearchChange를 주면 제어됩니다.",
    "Pagination은 DataToolbar 안에 넣지 않습니다. DataGrid 바로 아래에 별도 Pagination을 붙이고 page/pageSize/query를 제품이 제어합니다.",
    "Carbon Data table usage는 기본 table toolbar를 검색·필터·설정·export 같은 global action에, 선택 후 batch action bar를 선택 항목 작업에 사용합니다. LDS도 이 소유권 분리를 따릅니다.",
    "Carbon Pagination usage는 table pagination을 표 아래에 stack되는 별도 component로 정의합니다."
  ],
  "quantitativeRules": [
    {
      "subject": "--body1-line",
      "rule": "{\"fontSize\":\"16px\",\"lineHeight\":\"24px\",\"letterSpacing\":\"0.0057em\"}"
