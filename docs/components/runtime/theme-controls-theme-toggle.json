  "ownerComponents": [
    "ThemeToggle"
  ],
  "supportingComponents": [],
  "purpose": "사용자에게 명시적인 appearance 선택권을 제공하는 설정 표면에 적합합니다. 단순 장식 전환이나 일시적인 상태 표시에는 사용하지 않으며, 테마 변경 뒤에도 레이블·포커스·선택 상태가 분명해야 합니다.",
  "useWhen": [],
  "avoidWhen": [],
  "anatomy": [
    {
      "part": "showLabels",
      "rule": "각 아이콘 옆에 텍스트 라벨 표시. @default true"
    }
  ],
  "properties": [
    {
      "name": "target",
      "type": "HTMLElement | string | null",
      "required": false,
      "description": "[data-theme]를 설정할 요소(또는 CSS 셀렉터). null = 변경만 보고하고 DOM은 건드리지 않음. @default document.documentElement",
      "owner": "ThemeToggleProps"
    },
    {
      "name": "storageKey",
      "type": "string",
      "required": false,
      "description": "선택을 저장하는 데 쓰는 localStorage 키. @default \"lk-theme\"",
      "owner": "ThemeToggleProps"
    },
    {
      "name": "options",
      "type": "ThemeMode[]",
      "required": false,
      "description": "제공할 모드(순서대로). @default [\"light\",\"dark\",\"auto\"]",
      "owner": "ThemeToggleProps"
    },
    {
      "name": "value",
      "type": "ThemeMode",
      "required": false,
      "description": "제어되는 값.",
      "owner": "ThemeToggleProps"
    },
    {
      "name": "defaultValue",
      "type": "ThemeMode",
      "required": false,
      "description": "비제어 시 초기 값(저장된 선택이 있으면 우선). @default \"light\"",
      "owner": "ThemeToggleProps"
    },
    {
      "name": "onChange",
      "type": "(theme: ThemeMode) = void",
      "required": false,
      "description": "선택된 모드와 함께 호출.",
      "owner": "ThemeToggleProps"
    },
    {
      "name": "size",
      "type": "'sm' | 'md'",
      "required": false,
      "description": "",
      "owner": "ThemeToggleProps"
    },
    {
      "name": "showLabels",
      "type": "boolean",
      "required": false,
      "description": "각 아이콘 옆에 텍스트 라벨 표시. @default true",
      "owner": "ThemeToggleProps"
    },
    {
      "name": "persist",
      "type": "boolean",
      "required": false,
      "description": "선택을 localStorage에 저장(그리고 마운트 시 복원). @default true",
      "owner": "ThemeToggleProps"
    }
  ],
  "states": [],
  "behavior": [
    "테마를 구동하는 세그먼트형 Light / Dark / Auto 스위치. 대상 요소(기본 )에 [data-theme]를 설정하고 선택을 localStorage에 저장해, 어떤 페이지든 그 자리에서 테마를 바꿀 수 있습니다; auto는 OS를 따릅니다."
  ],
