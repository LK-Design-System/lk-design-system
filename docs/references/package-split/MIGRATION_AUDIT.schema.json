{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lk-robotics.github.io/schemas/lds-package-migration-audit.schema.json",
  "title": "LDS package and repository migration audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "audit",
    "verificationContract",
    "decisions",
    "packageCatalog",
    "ownership",
    "styles",
    "assets",
    "consumers",
    "baselines",
    "approvals"
  ],
  "properties": {
    "$schema": {
      "const": "./MIGRATION_AUDIT.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "audit": {
      "type": "object",
      "required": [
        "status",
        "capturedAt",
        "source",
        "readiness"
      ],
      "properties": {
        "status": {
          "enum": [
            "wave-0-in-progress",
            "wave-0-ready",
            "wave-0-approved"
          ]
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "object"
        },
        "readiness": {
          "type": "object",
          "required": [
            "integrityStatus",
            "wave0Gate",
            "blockers"
          ]
        }
      }
    },
    "verificationContract": {
      "type": "object"
    },
    "decisions": {
      "type": "object"
    },
    "packageCatalog": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "repository",
          "accountableOwnerRole",
          "accountableOwner",
          "ownerAssignmentStatus",
          "dependsOn",
          "moduleFormat",
          "stylesEntry"
        ]
      }
    },
    "ownership": {
      "type": "object"
    },
    "styles": {
      "type": "object"
    },
    "assets": {
      "type": "object"
    },
    "consumers": {
      "type": "object"
    },
    "baselines": {
      "type": "object",
      "required": [
        "cleanMain",
        "fullCheck",
        "packageArtifacts",
        "consumerMatrix"
      ],
      "properties": {
        "packageArtifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "lastKnownGoodReleaseSet",
            "tarballs"
          ],
          "properties": {
            "status": {
              "enum": [
                "not-captured",
                "captured"
              ]
            },
            "sourceCommit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "lastKnownGoodReleaseSet": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidencePath": {
              "const": "docs/references/package-split/baselines/WAVE0_AGGREGATE_ARTIFACT.json"
            },
            "evidenceSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "reproductionCommand": {
              "const": "npm run check:package-migration:wave0"
            },
            "tarballs": {
              "type": "array",
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "package",
                  "version",
                  "sourceCommit",
                  "artifactPath",
                  "sizeBytes",
                  "sha256"
                ],
                "properties": {
                  "package": {
                    "const": "@lk-design-system/design-system-core"
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sourceCommit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "artifactPath": {
                    "type": "string",
                    "pattern": "^visual-artifacts/package-smoke/pack/[A-Za-z0-9][A-Za-z0-9._-]*\\.tgz$"
                  },
                  "sizeBytes": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            },
            "diagnosticObservation": {
              "type": "object"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "captured"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "required": [
                  "sourceCommit",
                  "evidencePath",
                  "evidenceSha256",
                  "reproductionCommand"
                ],
                "properties": {
                  "lastKnownGoodReleaseSet": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tarballs": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1
                  }
                }
              },
              "else": {
                "properties": {
                  "lastKnownGoodReleaseSet": {
                    "type": "null"
                  },
                  "tarballs": {
                    "type": "array",
                    "maxItems": 0
                  }
                },
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "sourceCommit"
                      ]
                    },
                    {
                      "required": [
                        "evidencePath"
                      ]
                    },
                    {
                      "required": [
                        "evidenceSha256"
                      ]
                    },
                    {
                      "required": [
                        "reproductionCommand"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "approvals": {
      "type": "array"
    }
  }
}
