{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lk-robotics.github.io/schemas/lds-robotics-external-surface.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "kind", "package", "entries"],
  "properties": {
    "$schema": { "const": "./ROBOTICS_EXTERNAL_SURFACE.schema.json" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "lds-robotics-external-public-surface" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "repository"],
      "properties": {
        "name": { "const": "@lk-robotics/lds-robotics-ui" },
        "version": { "const": "0.1.0-rc.1" },
        "repository": { "const": "LK-ROBOTICS/lk-design-system-robotics" }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "exports"],
        "properties": {
          "source": { "type": "string", "pattern": "^components/[A-Za-z0-9_/-]+$" },
          "exports": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" } }
        }
      }
    }
  }
}
