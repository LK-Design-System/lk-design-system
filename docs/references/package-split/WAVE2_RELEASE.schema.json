{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lk-robotics.github.io/schemas/lds-wave2-registry-release.schema.json",
  "title": "LDS Wave 2 immutable registry release set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "capturedAt",
    "releaseSetId",
    "source",
    "registry",
    "tag",
    "packages",
    "verification",
    "rollback"
  ],
  "properties": {
    "$schema": { "const": "../WAVE2_RELEASE.schema.json" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "lds-wave2-registry-release" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "releaseSetId": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "commit", "gitTag"],
      "properties": {
        "repository": { "const": "LK-ROBOTICS/lk-design-system" },
        "branch": { "const": "main" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "gitTag": { "type": "string", "minLength": 1 }
      }
    },
    "registry": { "const": "https://npm.pkg.github.com" },
    "tag": { "type": "string", "minLength": 1 },
    "packages": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "version", "integrity", "shasum", "tarball"],
        "properties": {
          "id": { "enum": ["core", "theme", "product", "robotics-ui", "compatibility"] },
          "name": { "type": "string", "pattern": "^@lk-robotics/" },
          "version": { "type": "string", "minLength": 1 },
          "integrity": { "type": "string", "pattern": "^sha512-" },
          "shasum": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "tarball": { "type": "string", "format": "uri" }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prePublish", "registryLookup"],
      "properties": {
        "prePublish": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "registryLookup": { "type": "string", "minLength": 1 }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatibilityPackage", "version", "supportWindow"],
      "properties": {
        "compatibilityPackage": { "const": "@lk-robotics/design-system-core" },
        "version": { "type": "string", "minLength": 1 },
        "supportWindow": { "type": "string", "minLength": 1 }
      }
    }
  }
}
