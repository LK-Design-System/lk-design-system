{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lk-robotics.github.io/schemas/lds-package-artifact-baseline.schema.json",
  "title": "LDS Wave 0 aggregate package artifact baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "capturedAt",
    "repository",
    "sourceCommit",
    "sourceTag",
    "lastKnownGoodReleaseSet",
    "canonicalEnvironment",
    "inputs",
    "tarballs",
    "smoke",
    "verification"
  ],
  "properties": {
    "$schema": {
      "const": "../PACKAGE_ARTIFACT_BASELINE.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "lds-wave0-aggregate-artifact"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "const": "LK-ROBOTICS/lk-design-system"
    },
    "sourceCommit": {
      "$ref": "#/$defs/commit"
    },
    "sourceTag": {
      "type": "string",
      "minLength": 1
    },
    "lastKnownGoodReleaseSet": {
      "type": "string",
      "minLength": 1
    },
    "canonicalEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "arch",
        "node",
        "npm",
        "packageManager"
      ],
      "properties": {
        "platform": {
          "const": "win32"
        },
        "arch": {
          "const": "x64"
        },
        "node": {
          "const": "22.17.1"
        },
        "npm": {
          "const": "10.9.2"
        },
        "packageManager": {
          "const": "npm@10.9.2"
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lockfile",
        "lockfileSha256",
        "artifactVerifier",
        "artifactVerifierSha256",
        "installCommand",
        "buildCommand",
        "generatedCheckCommand",
        "packCommand"
      ],
      "properties": {
        "lockfile": {
          "const": "package-lock.json"
        },
        "lockfileSha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifactVerifier": {
          "const": "scripts/check-package-artifact.mjs"
        },
        "artifactVerifierSha256": {
          "$ref": "#/$defs/sha256"
        },
        "installCommand": {
          "const": "npm ci"
        },
        "buildCommand": {
          "const": "npm run build"
        },
        "generatedCheckCommand": {
          "const": "npm run check:generated"
        },
        "packCommand": {
          "const": "npm pack --json --ignore-scripts --pack-destination visual-artifacts/package-smoke/pack"
        }
      }
    },
    "tarballs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "package",
          "version",
          "sourceCommit",
          "artifactPath",
          "storage",
          "sizeBytes",
          "sha256",
          "fileCount",
          "unpackedSizeBytes"
        ],
        "properties": {
          "package": {
            "const": "@lk-design-system/design-system-core"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sourceCommit": {
            "$ref": "#/$defs/commit"
          },
          "artifactPath": {
            "type": "string",
            "pattern": "^visual-artifacts/package-smoke/pack/[A-Za-z0-9][A-Za-z0-9._-]*\\.tgz$"
          },
          "storage": {
            "const": "ignored-regenerated"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "fileCount": {
            "type": "integer",
            "minimum": 1
          },
          "unpackedSizeBytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "smoke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootButtonBundleBytes",
        "coreButtonBundleBytes",
        "iconAssets",
        "esm",
        "cjs",
        "types",
        "ssr"
      ],
      "properties": {
        "rootButtonBundleBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 153600
        },
        "coreButtonBundleBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 153600
        },
        "iconAssets": {
          "type": "integer",
          "minimum": 1
        },
        "esm": {
          "const": "passed"
        },
        "cjs": {
          "const": "passed"
        },
        "types": {
          "const": "passed"
        },
        "ssr": {
          "const": "passed"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "result"
      ],
      "properties": {
        "command": {
          "const": "npm run check:pack:baseline"
        },
        "result": {
          "const": "passed"
        }
      }
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
