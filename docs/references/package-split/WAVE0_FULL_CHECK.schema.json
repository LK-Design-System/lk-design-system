{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lk-robotics.github.io/schemas/lds-wave0-full-check.schema.json",
  "title": "LDS Wave 0 full check evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "capturedAt",
    "repository",
    "sourceCommit",
    "sourceTag",
    "status",
    "canonicalEnvironment",
    "commands",
    "coverage"
  ],
  "properties": {
    "$schema": { "const": "../WAVE0_FULL_CHECK.schema.json" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "lds-wave0-full-check" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "repository": { "const": "LK-ROBOTICS/lk-design-system" },
    "sourceCommit": { "$ref": "#/$defs/commit" },
    "sourceTag": { "type": "string", "minLength": 1 },
    "status": { "const": "passed" },
    "canonicalEnvironment": { "$ref": "#/$defs/canonicalEnvironment" },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "startedAt", "outputSha256"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "status": { "const": "passed" },
          "startedAt": { "type": "string", "format": "date-time" },
          "outputSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storybookVisual", "accessibility", "consumerSmoke", "packageArtifact"],
      "properties": {
        "storybookVisual": { "const": "passed" },
        "accessibility": { "const": "passed" },
        "consumerSmoke": { "const": "passed" },
        "packageArtifact": { "const": "passed" }
      }
    }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "canonicalEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "arch", "node", "npm", "packageManager"],
      "properties": {
        "platform": { "const": "win32" },
        "arch": { "const": "x64" },
        "node": { "const": "22.17.1" },
        "npm": { "const": "10.9.2" },
        "packageManager": { "const": "npm@10.9.2" }
      }
    }
  }
}
