{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lk-robotics.github.io/schemas/lds3d-external-surface.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "kind", "package", "upstreamTokenDependencies", "runtimeCustomProperties", "packages"],
  "properties": {
    "$schema": { "const": "./LDS3D_EXTERNAL_SURFACE.schema.json" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "lds3d-external-public-surface" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "name", "version", "repository"],
      "properties": {
        "manifest": { "const": "package.json" },
        "name": { "const": "lk-design-system-3d" },
        "version": { "const": "0.1.0-alpha.1" },
        "repository": { "const": "LK-ROBOTICS/lk-design-system-3d" }
      }
    },
    "upstreamTokenDependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^--[a-z0-9-]+$" } },
    "runtimeCustomProperties": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^--[a-z0-9-]+$" } },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["manifest", "name", "version", "exports"],
        "properties": {
          "manifest": { "type": "string", "pattern": "^packages/[a-z0-9-]+/package\\.json$" },
          "name": { "type": "string", "pattern": "^@lk-robotics/design-system-3d-" },
          "version": { "const": "0.1.0-alpha.1" },
          "exports": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^\\." } }
        }
      }
    }
  }
}
