{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lk-robotics.github.io/schemas/lds-wave3-user-approved-extraction.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "kind", "approvedAt", "priorDecision", "approval", "extraction", "remainingConditions"],
  "properties": {
    "$schema": { "const": "./WAVE3_USER_APPROVED_EXTRACTION.schema.json" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "lds-wave3-user-approved-extraction" },
    "approvedAt": { "type": "string", "format": "date-time" },
    "priorDecision": { "const": "docs/references/package-split/WAVE3_GO_NO_GO.json" },
    "approval": { "type": "object" },
    "extraction": { "type": "object" },
    "remainingConditions": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
