  "source": {
    "name": "Wanted Design System Community",
    "figmaFileKey": "4e0301GrjO6P8fOQpLUrrG",
    "inspectedAt": "2026-07-07"
  },
  "principle": "Preserve WDS structure and component semantics; replace color values and brand expression with LK ROBOTICS theme values.",
  "collections": {
    "Atomic": {
      "strategy": "Keep WDS neutral and accent roles as a reference scale. LK brand colors may replace the blue/primary decision points but should not rename semantic roles in component contracts."
    },
    "Theme": {
      "strategy": "Map WDS semantic variables to LK semantic CSS aliases. Product code should consume LK semantic aliases, not primitive brand hex values."
    },
    "Frame": {
      "strategy": "Expose WDS frame radius and padding decisions through LK aliases so component shape can stay WDS-compatible while remaining brandable."
    },
    "Component": {
      "strategy": "Component-specific values belong under component tokens only when they are unique to that component family."
    }
  },
  "theme": [
