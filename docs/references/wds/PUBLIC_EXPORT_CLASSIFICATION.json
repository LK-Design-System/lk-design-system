{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "source": {
    "name": "LK Design System public exports",
    "entrypoint": "src/index.js",
    "classifiedAt": "2026-07-07",
    "purpose": "Ensure every public LDS export is explicitly classified as WDS core, LK theme override, LK product extension, or LK robotics extension."
  },
  "classificationLegend": {
    "direct-wds": "A public export that directly supports a WDS core family or foundation role.",
    "wds-adjacent": "A generic export that supports a WDS section but still needs Figma node-level confirmation before being treated as direct WDS parity.",
    "theme-override": "A public export that applies LK ROBOTICS brand/theme decisions over WDS structure.",
    "product-extension": "A reusable LK product export beyond direct WDS coverage.",
    "robotics-extension": "A robotics, viewer, telemetry, map, or editor export beyond WDS core."
  },
