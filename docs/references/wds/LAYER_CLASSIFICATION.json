  "layers": {
    "wds-core": {
      "storybookPrefix": "LDS Core",
      "purpose": "WDS-derived foundations and generic component contracts. Public Storybook titles use Foundation/Components navigation groups; numbered WDS source labels stay in docs/references/wds evidence."
    },
    "lk-theme-override": {
      "storybookPrefix": "LDS Theme",
      "purpose": "LK ROBOTICS brand, color, and identity substitutions over the WDS structure."
    },
    "lk-product-extension": {
      "storybookPrefix": "LDS Product",
      "purpose": "Generic reusable product UI components and patterns that are useful in LK products but are not direct WDS core matches. This layer must not become full application screens, workflows, or demos."
    },
    "lk-robotics-extension": {
      "storybookPrefix": "LDS Robotics",
      "purpose": "Robotics, viewer, map, telemetry, and editor components that extend the WDS core. This layer must stay component/pattern focused rather than full robotics application screens."
    }
