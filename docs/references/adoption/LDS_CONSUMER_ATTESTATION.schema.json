{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lk-design-system.github.io/lk-design-system/schemas/lds-consumer-attestation.schema.json",
  "title": "LDS consumer adoption attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "consumerId",
    "generatedAt",
    "profile",
    "checks",
    "evidence"
  ],
  "properties": {
    "$schema": { "const": "../LDS_CONSUMER_ATTESTATION.schema.json" },
    "schemaVersion": { "const": 2 },
    "kind": { "const": "lds-consumer-attestation" },
    "consumerId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "generatedAt": { "type": "string", "format": "date" },
    "profile": { "enum": ["default", "ops"] },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "command"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "status": { "enum": ["passed", "not-run", "blocked"] },
          "command": { "type": "string", "minLength": 3 },
          "note": { "type": "string", "minLength": 3 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    }
  }
}
