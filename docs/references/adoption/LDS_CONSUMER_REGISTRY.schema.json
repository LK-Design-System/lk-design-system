{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lk-design-system.github.io/lk-design-system/schemas/lds-consumer-registry.schema.json",
  "title": "LDS consumer adoption registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "kind", "generatedAt", "ldsVersion", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "lds-consumer-registry" },
    "generatedAt": { "type": "string", "format": "date" },
    "ldsVersion": { "type": "string", "pattern": "^0\\.1\\.0-rc\\.[0-9]+\\.[0-9]+$" },
    "entries": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "command"],
      "properties": {
        "status": { "enum": ["passed", "not-run", "blocked"] },
        "command": { "type": "string", "minLength": 3 },
        "note": { "type": "string" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "artifactPath", "sha256"],
      "properties": {
        "name": { "type": "string", "pattern": "^@lk-design-system/lds-[a-z0-9-]+$" },
        "version": { "type": "string", "minLength": 5 },
        "artifactPath": { "type": "string", "minLength": 3 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "repository", "sourceCommit", "worktree", "frontendRoot", "profile",
        "themeModes", "packages", "stage", "checks", "viewports", "evidence",
        "evidenceFreshness", "attestation", "legacyActiveReferences"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "repository": { "type": "string", "minLength": 3 },
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "worktree": { "enum": ["clean", "dirty"] },
        "frontendRoot": { "type": "string", "minLength": 1 },
        "profile": { "enum": ["default", "ops"] },
        "themeModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["light", "dark"] }
        },
        "packages": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/package" }
        },
        "stage": { "enum": ["wired", "build-verified", "workflow-verified"] },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["install", "sourceContract", "productionBuild", "workflowSmoke", "accessibility"],
          "properties": {
            "install": { "$ref": "#/$defs/check" },
            "sourceContract": { "$ref": "#/$defs/check" },
            "productionBuild": { "$ref": "#/$defs/check" },
            "workflowSmoke": { "$ref": "#/$defs/check" },
            "accessibility": { "$ref": "#/$defs/check" }
          }
        },
        "viewports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9]+x[0-9]+$" }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        },
        "evidenceFreshness": { "enum": ["current", "stale"] },
        "staleReason": { "type": "string", "minLength": 3 },
        "attestation": { "type": "string", "minLength": 3 },
        "legacyActiveReferences": { "const": 0 },
        "notes": { "type": "string" }
      }
    }
  }
}
