{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lk-design-system.github.io/lk-design-system/schemas/lds-consumer-registry.schema.json",
  "title": "LDS consumer adoption registry",
  "$comment": "Promotion contract: docs/references/adoption/CONSUMER_ADOPTION_PROMOTION_CONTRACT.md",
  "description": "Package release, consumer workflow adoption, and product deployment are independent decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "generatedAt",
    "ldsVersion",
    "packageRelease",
    "entries"
  ],
  "properties": {
    "$schema": { "const": "./LDS_CONSUMER_REGISTRY.schema.json" },
    "schemaVersion": { "const": 2 },
    "kind": { "const": "lds-consumer-registry" },
    "generatedAt": { "type": "string", "format": "date" },
    "ldsVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-rc(?:\\.[0-9]+)+)?$"
    },
    "packageRelease": { "$ref": "#/$defs/packageRelease" },
    "entries": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "packageRelease": {
            "type": "object",
            "properties": { "channel": { "const": "release-candidate" } },
            "required": ["channel"]
          }
        },
        "required": ["packageRelease"]
      },
      "then": {
        "properties": {
          "ldsVersion": { "type": "string", "pattern": "-rc(?:\\.[0-9]+)+$" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "packageRelease": {
            "type": "object",
            "properties": { "channel": { "const": "stable" } },
            "required": ["channel"]
          }
        },
        "required": ["packageRelease"]
      },
      "then": {
        "properties": {
          "ldsVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "packageRelease": {
            "type": "object",
            "properties": {
              "availability": { "const": "verified" }
            },
            "required": [
              "releaseTag",
              "evidence",
              "supportPolicy",
              "rollbackArtifact"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "packageRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "availability"],
      "properties": {
        "channel": { "enum": ["release-candidate", "stable"] },
        "availability": { "enum": ["not-attested", "verified"] },
        "releaseTag": {
          "type": "string",
          "pattern": "^lds-v[0-9]+\\.[0-9]+\\.[0-9]+(?:-rc(?:\\.[0-9]+)+)?$"
        },
        "evidence": { "$ref": "#/$defs/evidence" },
        "supportPolicy": { "type": "string", "minLength": 3 },
        "rollbackArtifact": { "type": "string", "minLength": 3 },
        "note": { "type": "string", "minLength": 3 }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "availability": { "const": "verified" } },
            "required": ["availability"]
          },
          "then": { "required": ["releaseTag", "evidence"] }
        }
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "command"],
      "properties": {
        "status": { "enum": ["passed", "not-run", "blocked"] },
        "command": { "type": "string", "minLength": 3 },
        "note": { "type": "string" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "artifactPath", "sha256"],
      "properties": {
        "name": { "type": "string", "pattern": "^@lk-design-system/lds-[a-z0-9-]+$" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-rc(?:\\.[0-9]+)+)?$"
        },
        "artifactPath": { "type": "string", "minLength": 3 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "cleanReproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "mode", "sourceCommit", "verifiedAt", "command", "evidence"],
      "properties": {
        "status": { "const": "passed" },
        "mode": { "const": "clean-clone" },
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "verifiedAt": { "type": "string", "format": "date" },
        "command": { "type": "string", "minLength": 3 },
        "evidence": { "$ref": "#/$defs/evidence" },
        "note": { "type": "string", "minLength": 3 }
      }
    },
    "productOwnerApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "owner", "approvedAt", "evidence"],
      "properties": {
        "status": { "const": "approved" },
        "owner": { "type": "string", "minLength": 3 },
        "approvedAt": { "type": "string", "format": "date" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "note": { "type": "string", "minLength": 3 }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["not-attested", "rollout-ready", "deployed", "rolled-back"]
        },
        "owner": { "type": "string", "minLength": 3 },
        "verifiedAt": { "type": "string", "format": "date" },
        "environment": { "type": "string", "minLength": 2 },
        "evidence": { "$ref": "#/$defs/evidence" },
        "rollbackPlan": { "type": "string", "minLength": 3 },
        "note": { "type": "string", "minLength": 3 }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "status": { "enum": ["rollout-ready", "deployed", "rolled-back"] }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["owner", "verifiedAt", "environment", "evidence", "rollbackPlan"]
          }
        }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repository",
        "sourceCommit",
        "worktree",
        "frontendRoot",
        "profile",
        "themeModes",
        "packages",
        "stage",
        "checks",
        "viewports",
        "evidence",
        "evidenceFreshness",
        "attestation",
        "deployment",
        "legacyActiveReferences"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "repository": { "type": "string", "minLength": 3 },
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "worktree": { "enum": ["clean", "dirty"] },
        "frontendRoot": { "type": "string", "minLength": 1 },
        "profile": { "enum": ["default", "ops"] },
        "themeModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["light", "dark"] }
        },
        "packages": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/package" }
        },
        "stage": { "enum": ["registered", "wired", "build-verified", "workflow-verified"] },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["install", "sourceContract", "productionBuild", "workflowSmoke", "accessibility"],
          "properties": {
            "install": { "$ref": "#/$defs/check" },
            "sourceContract": { "$ref": "#/$defs/check" },
            "productionBuild": { "$ref": "#/$defs/check" },
            "workflowSmoke": { "$ref": "#/$defs/check" },
            "accessibility": { "$ref": "#/$defs/check" }
          }
        },
        "viewports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9]+x[0-9]+$" }
        },
        "evidence": { "$ref": "#/$defs/evidence" },
        "evidenceFreshness": { "enum": ["current", "stale"] },
        "staleReason": { "type": "string", "minLength": 3 },
        "attestation": { "type": "string", "minLength": 3 },
        "cleanReproducibility": { "$ref": "#/$defs/cleanReproducibility" },
        "productOwnerApproval": { "$ref": "#/$defs/productOwnerApproval" },
        "deployment": { "$ref": "#/$defs/deployment" },
        "legacyActiveReferences": { "const": 0 },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "stage": { "const": "registered" } },
            "required": ["stage"]
          },
          "then": {
            "properties": {
              "checks": {
                "type": "object",
                "properties": {
                  "install": { "type": "object", "properties": { "status": { "enum": ["not-run", "blocked"] } } },
                  "sourceContract": { "type": "object", "properties": { "status": { "enum": ["not-run", "blocked"] } } },
                  "productionBuild": { "type": "object", "properties": { "status": { "enum": ["not-run", "blocked"] } } },
                  "workflowSmoke": { "type": "object", "properties": { "status": { "enum": ["not-run", "blocked"] } } },
                  "accessibility": { "type": "object", "properties": { "status": { "enum": ["not-run", "blocked"] } } }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "evidenceFreshness": { "const": "stale" } },
            "required": ["evidenceFreshness"]
          },
          "then": { "required": ["staleReason"] }
        },
        {
          "if": {
            "type": "object",
            "properties": { "stage": { "const": "wired" } },
            "required": ["stage"]
          },
          "then": {
            "properties": {
              "checks": {
                "type": "object",
                "properties": {
                  "install": { "type": "object", "properties": { "status": { "const": "passed" } } },
                  "sourceContract": { "type": "object", "properties": { "status": { "const": "passed" } } }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "stage": { "const": "build-verified" } },
            "required": ["stage"]
          },
          "then": {
            "properties": {
              "checks": {
                "type": "object",
                "properties": {
                  "install": { "type": "object", "properties": { "status": { "const": "passed" } } },
                  "sourceContract": { "type": "object", "properties": { "status": { "const": "passed" } } },
                  "productionBuild": { "type": "object", "properties": { "status": { "const": "passed" } } }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "stage": { "const": "workflow-verified" } },
            "required": ["stage"]
          },
          "then": {
            "required": ["cleanReproducibility", "productOwnerApproval"],
            "properties": {
              "checks": {
                "type": "object",
                "properties": {
                  "install": { "type": "object", "properties": { "status": { "const": "passed" } } },
                  "sourceContract": { "type": "object", "properties": { "status": { "const": "passed" } } },
                  "productionBuild": { "type": "object", "properties": { "status": { "const": "passed" } } },
                  "workflowSmoke": { "type": "object", "properties": { "status": { "const": "passed" } } },
                  "accessibility": { "type": "object", "properties": { "status": { "const": "passed" } } }
                }
              }
            }
          }
        }
      ]
    }
  }
}
