{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://design.lk-robotics.com/contracts/korean-ui-copy/v1",
  "title": "LDS Korean UI copy-set catalog",
  "description": "Product-owned UI copy sets reviewed under the LDS copy review contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "contractVersion", "productId", "rulesetVersion", "copySets"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "contractId": { "const": "https://design.lk-robotics.com/contracts/korean-ui-copy/v1" },
    "contractVersion": { "const": "2026-08-04" },
    "productId": { "$ref": "#/$defs/nonEmptyString" },
    "rulesetVersion": { "$ref": "#/$defs/nonEmptyString" },
    "copySets": {
      "type": "array",
      "items": { "$ref": "#/$defs/copySet" }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "role": {
      "enum": [
        "navigation",
        "page_title",
        "object_name",
        "status",
        "heading",
        "description",
        "field_label",
        "button",
        "button_status",
        "link",
        "aria_label",
        "placeholder",
        "helper",
        "error",
        "empty",
        "loading",
        "success",
        "confirmation"
      ]
    },
    "reasonCode": {
      "enum": [
        "NO_CHANGE_REQUIRED",
        "COPY_INTERNAL",
        "COPY_CANONICAL",
        "COPY_PLACEHOLDER",
        "COPY_FACT",
        "COPY_STATE",
        "COPY_VAGUE",
        "COPY_SENTENCE",
        "COPY_NATURAL",
        "COPY_OVEREDIT"
      ]
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "file"],
      "properties": {
        "kind": { "enum": ["ui", "api_error", "background_job", "template"] },
        "file": { "$ref": "#/$defs/nonEmptyString" },
        "anchor": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "copyItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "role", "text", "sources"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "role": { "$ref": "#/$defs/role" },
        "text": { "$ref": "#/$defs/nonEmptyString" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceReference" }
        }
      }
    },
    "machineProtected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["properNouns", "placeholders", "numbersAndUnits", "literals"],
      "properties": {
        "properNouns": { "$ref": "#/$defs/uniqueStrings" },
        "placeholders": { "$ref": "#/$defs/uniqueStrings" },
        "numbersAndUnits": { "$ref": "#/$defs/uniqueStrings" },
        "literals": { "$ref": "#/$defs/uniqueStrings" }
      }
    },
    "humanProtected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facts", "behavior", "permissionsAndLifecycle"],
      "properties": {
        "facts": { "$ref": "#/$defs/uniqueStrings" },
        "behavior": { "$ref": "#/$defs/uniqueStrings" },
        "permissionsAndLifecycle": { "$ref": "#/$defs/uniqueStrings" }
      }
    },
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "verdict", "reasonCodes"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "verdict": { "enum": ["KEEP", "REVISE", "BLOCKED"] },
        "text": { "$ref": "#/$defs/nonEmptyString" },
        "reasonCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reasonCode" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "verdict": { "const": "REVISE" } } },
          "then": {
            "properties": { "text": { "$ref": "#/$defs/nonEmptyString" } },
            "required": ["text"]
          },
          "else": {
            "properties": { "text": false }
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceHash",
        "candidateHash",
        "verdict",
        "semanticDelta",
        "decisions",
        "questions",
        "reviewer",
        "reviewedAt"
      ],
      "properties": {
        "sourceHash": { "$ref": "#/$defs/hash" },
        "candidateHash": { "$ref": "#/$defs/hash" },
        "verdict": { "enum": ["KEEP", "REVISE", "BLOCKED"] },
        "semanticDelta": { "enum": ["NONE", "POSSIBLE", "UNKNOWN"] },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/decision" }
        },
        "questions": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "reviewer": { "$ref": "#/$defs/nonEmptyString" },
        "reviewedAt": { "type": "string", "format": "date-time" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "reviewer",
        "reviewedAt",
        "sourceHash",
        "candidateHash",
        "rulesetVersion"
      ],
      "properties": {
        "role": { "$ref": "#/$defs/nonEmptyString" },
        "reviewer": { "$ref": "#/$defs/nonEmptyString" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "sourceHash": { "$ref": "#/$defs/hash" },
        "candidateHash": { "$ref": "#/$defs/hash" },
        "rulesetVersion": { "$ref": "#/$defs/nonEmptyString" },
        "evidence": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "copySet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceHash",
        "surface",
        "audience",
        "task",
        "policyTags",
        "items",
        "protected",
        "review",
        "approvals"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "sourceHash": { "$ref": "#/$defs/hash" },
        "surface": { "$ref": "#/$defs/nonEmptyString" },
        "audience": { "$ref": "#/$defs/nonEmptyString" },
        "task": { "$ref": "#/$defs/nonEmptyString" },
        "policyTags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/copyItem" }
        },
        "protected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["machine", "humanReview"],
          "properties": {
            "machine": { "$ref": "#/$defs/machineProtected" },
            "humanReview": { "$ref": "#/$defs/humanProtected" }
          }
        },
        "review": { "$ref": "#/$defs/review" },
        "approvals": {
          "type": "array",
          "items": { "$ref": "#/$defs/approval" }
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding", "owner", "reason", "expiresOn"],
      "properties": {
        "finding": { "$ref": "#/$defs/nonEmptyString" },
        "owner": { "$ref": "#/$defs/nonEmptyString" },
        "reason": { "$ref": "#/$defs/nonEmptyString" },
        "expiresOn": { "type": "string", "format": "date" }
      }
    }
  }
}
