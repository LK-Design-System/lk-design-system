# LDS package release operator settings. Copy to ~/.config/lds-release/release.env
# (or point LDS_RELEASE_ENV at another file) and adjust. Contains no secrets: GitHub
# access comes from `gh auth` (admin:org for runner registration tokens), host access
# from the operator's SSH config. Keep host addresses and keys out of this repository.

# Canonical repository and the local checkout used to resolve the release tag.
LDS_RELEASE_REPO=LK-Design-System/lk-design-system
LDS_CHECKOUT=/path/to/lk-workspace/shared/lk-design-system

# Fixed release VM host (SSH alias with a pinned host key). Do not change it to the
# current PC or another host. The guest directory and its host-side prepare.sh are
# set up on server04; missing settings are blockers, not setup approval.
LDS_RELEASE_VM_HOST=server04
LDS_RELEASE_VM_ROOT=/home/<release-user>/.local/share/lk-lds-release-kvm/<yyyymmdd>
# Single-use runner identity. Only one lk-lds-release-linux-x64 runner may exist.
LDS_RELEASE_RUNNER_NAME=lk-lds-release-server04-<yyyymmdd>
LDS_RELEASE_RUNNER_GROUP=lk-lds-release-ephemeral
LDS_RELEASE_RUNNER_GROUP_ID=<runner-group-id>
LDS_RELEASE_RUNNER_LABEL=lk-lds-release-linux-x64
